import pandas as pd
import re

# Read the original MoMA file.
df = pd.read_csv("Artworks.csv", low_memory=False)
print("Original rows:", len(df))

# Some dates have one year, some have a range or a decade.
def find_year(date):
    if pd.isna(date):
        return None, None, "missing"

    text = str(date).strip().lower()

    if text == "" or text in ["unknown", "n.d.", "n.d", "undated"]:
        return None, None, "missing"

    # These dates do not tell us an exact starting and ending year.
    if "before" in text or "after" in text:
        return None, None, "unclear"

    # Example: 1980s = 1980 to 1989.
    decade = re.search(r"(?<!\d)(\d{3,4})s(?!\w)", text)

    # Example: 1934-36 means 1934 to 1936.
    short_range = re.search(r"(\d{4})\s*[-–/]\s*(\d{2})(?!\d)", text)

    years = re.findall(r"(?<!\d)\d{3,4}(?!\d)", text)

    if decade:
        lower = int(decade.group(1))
        upper = lower + 9
        kind = "decade"
    elif short_range:
        lower = int(short_range.group(1))
        upper = int(str(lower)[:2] + short_range.group(2))
        if upper < lower:
            upper = upper + 100
        kind = "range"
    elif len(years) >= 2:
        lower = int(years[0])
        upper = int(years[1])
        kind = "range"
    elif len(years) == 1:
        lower = int(years[0])
        upper = lower
        kind = "exact"
    else:
        return None, None, "unclear"

    # Keep B.C. dates instead of removing early artworks.
    simple_text = text.replace(".", "")
    if "bc" in simple_text or "bce" in simple_text:
        lower, upper = -max(lower, upper), -min(lower, upper)
        kind = "BC"

    if lower > upper:
        lower, upper = upper, lower

    if kind == "exact" and ("circa" in text or "c." in text or "ca." in text):
        kind = "circa"

    return lower, upper, kind

# Calculate three year columns for each artwork.
low_list = []
high_list = []
mid_list = []
type_list = []

for date in df["Date"]:
    low, high, date_type = find_year(date)
    low_list.append(low)
    high_list.append(high)
    type_list.append(date_type)

    if low is None:
        mid_list.append(None)
    else:
        mid_list.append((low + high) / 2)

df["year_lower"] = low_list
df["year_upper"] = high_list
df["year_mid"] = mid_list
df["date_type"] = type_list

# Only remove rows whose creation year cannot be determined.
clean = df.dropna(subset=["year_mid"]).copy()

# Save a separate comparison file so the group's final CSV is not overwritten.
clean.to_csv("Artworks_dates_rebuilt.csv", index=False)

print("Cleaned rows:", len(clean))
print("Average creation year:", round(clean["year_mid"].mean(), 6))
print("Standard deviation:", round(clean["year_mid"].std(ddof=0), 6))
print("Rows before 1800:", (clean["year_mid"] < 1800).sum())
print("Saved: Artworks_dates_rebuilt.csv")
