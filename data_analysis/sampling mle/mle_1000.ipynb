import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm

# Read the sample saved in the sampling step.
sample = pd.read_csv("sample_1000.csv")
years = pd.to_numeric(sample["year_mid"], errors="coerce").dropna()

# In a Normal model with fixed sigma, the MLE of mu is the sample mean.
mu = years.mean()
sigma = 34.05

print("Sample size:", len(years))
print("MLE mu:", round(mu, 4))
print("Fixed sigma:", sigma)

# Compare the observed years with the fitted Normal curve.
x = np.linspace(years.min() - 20, years.max() + 20, 400)
y = norm.pdf(x, loc=mu, scale=sigma)

plt.hist(years, bins=20, density=True, color="lightblue", edgecolor="white")
plt.plot(x, y, color="orangered", linewidth=2, label="Fitted Normal")
plt.xlabel("Creation year")
plt.ylabel("Density")
plt.title("Normal MLE: n = 1000, mu = " + str(round(mu, 2)))
plt.legend()
plt.tight_layout()
plt.savefig("mle_1000.png", dpi=150)
plt.show()
